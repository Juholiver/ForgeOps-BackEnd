# --- Development defaults (used by docker compose) ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=forgeops
POSTGRES_USER=forgeops
POSTGRES_PASSWORD=forgeops

# Redis is also the Celery broker/result backend (celery_app.py).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Legacy: the Celery broker moved to Redis. RABBITMQ_* is only kept because the
# production settings validation still requires a non-default RABBITMQ_PASSWORD.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=forgeops
RABBITMQ_PASSWORD=forgeops
RABBITMQ_VHOST=/

CORS_ORIGINS=["http://localhost:3000"]

# --- Google OAuth 2.0 (login exclusivo via Google) ---
# Create the credentials in Google Cloud Console > APIs & Services > Credentials
# (OAuth 2.0 Client ID, type "Web application") and use the SAME redirect URI
# registered there as GOOGLE_REDIRECT_URI. Values are per-environment, never
# committed for production.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Frontend origin that receives /auth/callback?access_token=... after login
FRONTEND_URL=http://localhost:3000

LOG_LEVEL=INFO

# Database backend: postgres | sqlite (sqlite = local dev fallback, no Docker)
DB_BACKEND=postgres

# Backend runs alembic migrations on startup when set to 1 (set automatically
# for the backend service by docker-compose.yml; leave 0/empty elsewhere)
RUN_MIGRATIONS=0

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Image reference used by docker compose (set by the CD pipeline to the GHCR
# image, e.g. ghcr.io/<owner>/forgeops-backend:latest)
BACKEND_IMAGE=forgeops-backend:local

# --- Production (copy this file to .env.prod and change EVERYTHING below) ---
# Usage: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d
#
# APP_ENV=production
# APP_SECRET_KEY=            # openssl rand -hex 32 (REQUIRED - startup fails without it)
# POSTGRES_PASSWORD=         # openssl rand -hex 16 (REQUIRED)
# RABBITMQ_PASSWORD=         # openssl rand -hex 16 (REQUIRED)
# GRAFANA_ADMIN_PASSWORD=    # openssl rand -hex 16
# DB_BACKEND=postgres
# BACKEND_IMAGE=ghcr.io/<owner>/forgeops-backend:latest
# CORS_ORIGINS=["https://your-domain.example"]   # frontend origin (see forgeops-frontend README)
